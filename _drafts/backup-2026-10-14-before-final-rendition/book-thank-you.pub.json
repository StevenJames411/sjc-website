{"data":{"_pub":1,"root":{"props":{"title":"Your Book: Attention To Dollars | Steven James Consulting","description":"Download Attention To Dollars."}},"zones":{},"content":[{"type":"DesignSection","props":{"id":"book-thank-you","band":"ink-glow","html":"<section class=\"code-section relative bg-[#e5e5e5] py-10 lg:py-14 overflow-hidden\" id=\"sbookty\">\n<style>\n/* THE BUYER'S PAGE SHOWS WHAT EACH BUTTON HANDS OVER (Steven, 2026-10-08): the top is the thank-you and the book;\n   under it every download is a tall picture with its button beneath, the two books first, then the three study\n   guides. Never small pictures in a row. On a phone each one is its own tall tile. */\n#sbookty .ty-grid{display:grid;grid-template-columns:1fr;gap:28px;align-items:center}\n#sbookty .ty-book{order:-1}\n#sbookty .ty-book img{display:block;margin:0 auto;width:70%;max-width:400px;height:auto}\n#sbookty .ty-dl{margin-top:40px}\n#sbookty .ty-tiles{display:grid;grid-template-columns:1fr;gap:16px;margin-top:14px}\n#sbookty .ty-tiles>div{display:flex;flex-direction:column;align-items:center;gap:14px;border:1.5px solid #DE8634;border-radius:18px;padding:18px 16px 20px;background:rgba(222,134,52,.05)}\n#sbookty .ty-tiles img{display:block;width:100%!important;max-width:420px!important;height:auto!important;margin:0 auto!important}\n#sbookty .ty-tiles a{max-width:400px}\n@media (min-width:640px){\n  #sbookty .ty-tiles{grid-template-columns:repeat(6,minmax(0,1fr));gap:18px}\n  #sbookty .ty-two>div{grid-column:span 3}\n  #sbookty .ty-three>div{grid-column:span 6}\n  #sbookty .ty-three img{max-width:420px!important}\n  #sbookty .ty-two img{max-width:min(520px,calc(100svh - 320px))!important}\n}\n@media (min-width:1024px){\n  #sbookty .ty-three>div{grid-column:span 2}\n  #sbookty .ty-three img{max-width:100%!important}\n  #sbookty .ty-grid{grid-template-columns:minmax(0,1fr) auto;column-gap:64px}\n  #sbookty .ty-book{order:2}\n  #sbookty .ty-book img{width:auto;max-width:none;height:min(calc(100svh - 97px - 96px),760px)}\n  #sbookty .ty-dl{margin-top:64px}\n}\n</style>\n<div class=\"container mx-auto px-4\">\n<div class=\"ty-grid\">\n<div>\n<p class=\"font-[var(--font-family-body)] font-bold\" style=\"margin:0 0 8px;color:#F6BC76;letter-spacing:.08em;text-transform:uppercase\">{{t:t1}}</p>\n<h1 class=\"text-3xl lg:text-4xl font-bold font-[var(--font-family-heading)] leading-tight\" style=\"color:#fff;margin:0 0 12px\">{{t:t2}}</h1>\n<p class=\"font-[var(--font-family-body)] text-lg lg:text-xl\" style=\"color:#fff;line-height:1.6;margin:0\">{{t:t3}}</p>\n</div>\n<div class=\"ty-book\"><img width=\"747\" height=\"1108\" src=\"{{i:i1}}\" alt=\"The book Attention To Dollars by Steven Barchetti, Steven James Consulting\" loading=\"eager\" decoding=\"async\" data-sjc-img=\"i1\"></div>\n</div>\n<div class=\"ty-dl\" data-sjc-dl>\n<p class=\"font-[var(--font-family-body)] font-bold\" style=\"margin:0;color:#F6BC76;letter-spacing:.08em;text-transform:uppercase;font-size:14px\">{{t:t8}}</p>\n<div class=\"ty-tiles ty-two\"><div><img width=\"700\" height=\"700\" src=\"{{i:i11}}\" alt=\"The book Attention To Dollars shown on a tablet\" loading=\"lazy\" decoding=\"async\" data-sjc-img=\"i11\"><a href=\"{{h:h1}}\" download class=\"sjc-cta block w-full bg-[var(--primary-color)] text-white px-6 py-3 rounded-lg font-bold font-[var(--font-family-body)] shadow-xl text-center text-base border-2 border-[var(--primary-color)]\" data-sjc-link=\"h1\">{{t:t4}}</a></div><div><img width=\"700\" height=\"700\" src=\"{{i:i12}}\" alt=\"The book Attention To Dollars shown on a Kindle\" loading=\"lazy\" decoding=\"async\" data-sjc-img=\"i12\"><a href=\"{{h:h2}}\" download class=\"sjc-cta block w-full bg-[var(--primary-color)] text-white px-6 py-3 rounded-lg font-bold font-[var(--font-family-body)] shadow-xl text-center text-base border-2 border-[var(--primary-color)]\" data-sjc-link=\"h2\">{{t:t5}}</a></div></div>\n<p class=\"font-[var(--font-family-body)]\" style=\"color:#fff;opacity:.88;line-height:1.55;margin:14px 0 0;font-size:16px;max-width:760px\">{{t:t9}}</p>\n<p class=\"font-[var(--font-family-body)] font-bold\" style=\"margin:36px 0 0;color:#F6BC76;letter-spacing:.08em;text-transform:uppercase;font-size:14px\">{{t:t10}}</p>\n<div class=\"ty-tiles ty-three\"><div><img width=\"1050\" height=\"1400\" src=\"{{i:i13}}\" alt=\"Study guide for your phone\" loading=\"lazy\" decoding=\"async\" data-sjc-img=\"i13\"><a href=\"{{h:h4}}\" download class=\"sjc-cta block w-full bg-[var(--primary-color)] text-white px-6 py-3 rounded-lg font-bold font-[var(--font-family-body)] shadow-xl text-center text-base border-2 border-[var(--primary-color)]\" data-sjc-link=\"h4\">{{t:t12}}</a></div><div><img width=\"1050\" height=\"1400\" src=\"{{i:i14}}\" alt=\"Study guide for your tablet\" loading=\"lazy\" decoding=\"async\" data-sjc-img=\"i14\"><a href=\"{{h:h5}}\" download class=\"sjc-cta block w-full bg-[var(--primary-color)] text-white px-6 py-3 rounded-lg font-bold font-[var(--font-family-body)] shadow-xl text-center text-base border-2 border-[var(--primary-color)]\" data-sjc-link=\"h5\">{{t:t13}}</a></div><div><img width=\"1050\" height=\"1400\" src=\"{{i:i15}}\" alt=\"Study guide for your laptop\" loading=\"lazy\" decoding=\"async\" data-sjc-img=\"i15\"><a href=\"{{h:h6}}\" download class=\"sjc-cta block w-full bg-[var(--primary-color)] text-white px-6 py-3 rounded-lg font-bold font-[var(--font-family-body)] shadow-xl text-center text-base border-2 border-[var(--primary-color)]\" data-sjc-link=\"h6\">{{t:t14}}</a></div></div>\n<p class=\"font-[var(--font-family-body)]\" style=\"color:#fff;opacity:.88;line-height:1.55;margin:14px 0 0;font-size:16px;max-width:760px\">{{t:t11}}</p>\n<p class=\"font-[var(--font-family-body)]\" style=\"color:#fff;opacity:.72;line-height:1.5;margin:14px 0 0;font-size:13px;max-width:760px\">{{t:t15}}</p>\n</div>\n</div></section>","text":[{"key":"t1","label":"Text: eyebrow","value":"Thank you"},{"key":"t2","label":"Text: title","value":"Here is your book. This is your digital assets page."},{"key":"t3","label":"Text: line","value":"Attention To Dollars is yours, and so is the study guide that goes with it. Pick the file for the app you read in, then pick the study guide that fits your screen. Save this page so you can come back to it. If you ever lose a file, you can download it again right here."},{"key":"t4","label":"Link: Download For Apple Books","value":"Download For Apple Books"},{"key":"t5","label":"Link: Download For Kindle","value":"Download For Kindle"},{"key":"t8","label":"Text: label above the book buttons","value":"The book"},{"key":"t9","label":"Text: why the book comes in two files","value":"These two are for reading. Kindle and Apple Books resize the book to fit whatever you open it on, whether that is a phone, a tablet or a computer."},{"key":"t10","label":"Text: label above the study guide buttons","value":"The study guide"},{"key":"t11","label":"Text: why the study guide comes in three sizes","value":"The study guide is for ticking your way through as you build. A PDF cannot resize itself the way Kindle and Apple Books do, so we made it in three sizes, one to fit each screen. Pick the one for the device you will work on. Save it first, then open it from where you saved it, and your ticks stay."},{"key":"t12","label":"Link: Study Guide For Phone","value":"Study Guide For Phone"},{"key":"t13","label":"Link: Study Guide For Tablet","value":"Study Guide For Tablet"},{"key":"t14","label":"Link: Study Guide For Laptop","value":"Study Guide For Laptop"},{"key":"t15","label":"Text: copyright notice","value":"© 2026 Steven Barchetti, Steven James Consulting. All rights reserved. Every file on this page is a signature edition made for you. It is a copyrighted edition, not to be shared."}],"boxes":[],"links":[{"key":"h1","href":"/get-the-book","label":"Download For Apple Books"},{"key":"h2","href":"/get-the-book","label":"Download For Kindle"},{"key":"h4","href":"/get-the-book","label":"Study Guide For Phone"},{"key":"h5","href":"/get-the-book","label":"Study Guide For Tablet"},{"key":"h6","href":"/get-the-book","label":"Study Guide For Laptop"}],"sheet":"7b6d59e91bbcfde5","images":[{"alt":"The book Attention To Dollars by Steven Barchetti, Steven James Consulting","key":"i1","src":"https://ddhmhtqvn5lepkpr.public.blob.vercel-storage.com/sites/sjc-website/uploads/1791498396350-V12-copper-book-alone-glow.webp"},{"alt":"The book on a tablet","key":"i11","src":"https://ddhmhtqvn5lepkpr.public.blob.vercel-storage.com/sites/sjc-website/uploads/1791497834900-five-1-apple-books-glow-and-rims.webp"},{"alt":"The book on a Kindle","key":"i12","src":"https://ddhmhtqvn5lepkpr.public.blob.vercel-storage.com/sites/sjc-website/uploads/1791497628064-five-2-kindle-light-kindle.webp"},{"alt":"Study guide for your phone","key":"i13","src":"https://ddhmhtqvn5lepkpr.public.blob.vercel-storage.com/sites/sjc-website/uploads/1791499897879-study-guide-tile-phone.webp"},{"alt":"Study guide for your tablet","key":"i14","src":"https://ddhmhtqvn5lepkpr.public.blob.vercel-storage.com/sites/sjc-website/uploads/1791499897879-study-guide-tile-tablet.webp"},{"alt":"Study guide for your laptop","key":"i15","src":"https://ddhmhtqvn5lepkpr.public.blob.vercel-storage.com/sites/sjc-website/uploads/1791499897879-study-guide-tile-laptop.webp"}],"calLink":"","hasForm":false,"formButton":"","formFields":[],"paddingTop":48,"useRealForm":false,"paddingBottom":48}}]}}