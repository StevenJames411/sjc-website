{"data":{"root":{"props":{"title":"Get The Book: Attention To Dollars | Steven James Consulting","description":"Attention To Dollars, $495.00. One payment, and you download it right away."}},"zones":{},"content":[{"type":"DesignSection","props":{"id":"book-buy-page","band":"ink-glow","html":"<section class=\"code-section relative bg-[#e5e5e5] py-10 lg:py-14 overflow-hidden\" id=\"sbookbuy\">\n<style>\n/* THREE PARTS, EACH ITS OWN SECTION (Steven, 2026-10-08): the book full height with the words and the buy button;\n   then what you get, TALL, the same five tiles as the book's own page; then the checkout. ⛔ Never small pictures\n   in a row: \"they're like thumbnails. You can't even read them. When you stay tall, you might have to scroll the\n   page more, but nobody cares.\" */\n#sbookbuy .buy-grid{display:grid;grid-template-columns:1fr;gap:26px;align-items:center}\n#sbookbuy .buy-grid>*{min-width:0}\n#sbookbuy .buy-book img{display:block;margin:0 auto;width:78%;max-width:440px;height:auto}\n@media (min-width:1024px){\n  #sbookbuy .buy-grid{grid-template-columns:auto minmax(0,1fr);column-gap:64px}\n  #sbookbuy .buy-book img{width:auto;max-width:none;height:min(calc(100svh - 97px - 56px),900px);margin:0}\n    }\n</style>\n<div class=\"container mx-auto px-4\">\n<div class=\"buy-grid\">\n<div class=\"buy-book\"><img width=\"747\" height=\"1108\" src=\"{{i:i1}}\" alt=\"The book Attention To Dollars by Steven Barchetti\" loading=\"eager\" decoding=\"async\" fetchpriority=\"high\" data-sjc-img=\"i1\"></div>\n<div>\n<p class=\"font-[var(--font-family-body)] font-bold\" style=\"margin:0 0 8px;color:#F6BC76;letter-spacing:.08em;text-transform:uppercase\">{{t:t1}}</p>\n<h1 class=\"text-3xl lg:text-4xl font-bold font-[var(--font-family-heading)] leading-tight\" style=\"color:#fff;margin:0 0 6px\">{{t:t2}}</h1>\n<p class=\"font-[var(--font-family-body)]\" style=\"color:#F6BC76;font-weight:700;font-size:1.5rem;line-height:1.3;margin:0 0 14px\">{{t:t3}}</p>\n<p class=\"font-[var(--font-family-body)] text-lg\" style=\"color:#fff;line-height:1.6;margin:0\">{{t:t4}}</p>\n<div style=\"max-width:400px;margin-top:22px\"><a href=\"{{h:h1}}\" class=\"sjc-cta block w-full bg-[var(--primary-color)] text-white px-6 py-3 rounded-lg font-bold font-[var(--font-family-body)] shadow-xl text-center text-base border-2 border-[var(--primary-color)]\" data-sjc-link=\"h1\">{{t:t5}}</a></div>\n</div>\n</div>\n</div></section>","text":[{"key":"t1","label":"Text: Get the book","value":"Get the book"},{"key":"t2","label":"Heading: Attention To Dollars","value":"Attention To Dollars"},{"key":"t3","label":"Text: $495.00","value":"$495.00. One payment. Yours to keep."},{"key":"t4","label":"Text: After you pay","value":"After you pay, you download five things right away: the book for Apple Books and for Kindle, and the study guide in three sizes. Every copy is a signature edition with your name on it."},{"key":"t5","label":"Link: Buy The Book Now","value":"Buy The Book Now"}],"boxes":[],"links":[{"key":"h1","href":"#checkout","label":"Buy The Book Now"}],"sheet":"7b6d59e91bbcfde5","images":[{"alt":"The book Attention To Dollars by Steven Barchetti","key":"i1","src":"https://ddhmhtqvn5lepkpr.public.blob.vercel-storage.com/sites/sjc-website/uploads/1791498396350-V12-copper-book-alone-glow.webp"}],"calLink":"","hasForm":false,"formButton":"","formFields":[],"paddingTop":48,"useRealForm":false,"paddingBottom":48}},{"type":"DesignSection","props":{"id":"book-five-things","band":"ink-glow","html":"<section class=\"code-section relative py-10 lg:py-14 overflow-hidden\" id=\"sfive\"><style>\n/* TALL AND STACKED, not five thumbnails across (Steven, 2026-10-08): the two book formats first, side by side and\n   as tall as the screen allows, then the three study guides under them. On a phone every one is its own tall tile. */\n#sfive .five{display:grid;grid-template-columns:1fr;gap:16px;margin-top:22px}\n#sfive .five>div{display:flex;flex-direction:column;align-items:center;text-align:center;gap:10px;border:1.5px solid #DE8634;border-radius:18px;padding:18px 16px 20px;background:rgba(222,134,52,.05)}\n#sfive .five img{display:block;width:100%!important;max-width:420px!important;height:auto!important;margin:0 auto!important}\n#sfive .five p:first-child{font-size:1.25rem}\n@media (min-width:640px){\n  #sfive .five{grid-template-columns:repeat(6,minmax(0,1fr));gap:18px}\n  #sfive .five>div{grid-column:span 6}\n  #sfive .five>div:nth-child(-n+2){grid-column:span 3}\n  #sfive .five>div:nth-child(-n+2) img{max-width:min(560px,calc(100svh - 300px))!important}\n  /* The study guides are drawn to be READ (\"absolute mouse print\" was his word for the first ones): each fills its tile. */\n  #sfive .five>div:nth-child(n+3) img{max-width:420px!important}\n}\n@media (min-width:1024px){\n  #sfive .five>div:nth-child(n+3){grid-column:span 2}\n  #sfive .five>div:nth-child(n+3) img{max-width:100%!important}\n}\n</style><div class=\"container mx-auto px-4\"><p class=\"font-[var(--font-family-body)] font-bold\" style=\"margin:0 0 8px;color:#F6BC76;letter-spacing:.08em;text-transform:uppercase\">{{t:t1}}</p><h2 class=\"text-3xl lg:text-4xl font-bold font-[var(--font-family-heading)] leading-tight\" style=\"color:#fff;margin:0 0 12px\">{{t:t2}}</h2><p class=\"font-[var(--font-family-body)] text-lg\" style=\"color:#fff;line-height:1.6;margin:0;max-width:820px\">{{t:t3}}</p><div class=\"five\"><div><img width=\"700\" height=\"700\" src=\"{{i:i1}}\" alt=\"The book Attention To Dollars shown on a tablet\" loading=\"lazy\" decoding=\"async\" data-sjc-img=\"i1\"><div><p class=\"font-[var(--font-family-body)]\" style=\"color:#fff;font-weight:700;margin:0;line-height:1.3\">{{t:t11}}</p><p class=\"font-[var(--font-family-body)]\" style=\"color:#fff;opacity:.85;margin:4px 0 0;font-size:14px;line-height:1.45\">{{t:t12}}</p></div></div><div><img width=\"700\" height=\"700\" src=\"{{i:i2}}\" alt=\"The book Attention To Dollars shown on a Kindle\" loading=\"lazy\" decoding=\"async\" data-sjc-img=\"i2\"><div><p class=\"font-[var(--font-family-body)]\" style=\"color:#fff;font-weight:700;margin:0;line-height:1.3\">{{t:t13}}</p><p class=\"font-[var(--font-family-body)]\" style=\"color:#fff;opacity:.85;margin:4px 0 0;font-size:14px;line-height:1.45\">{{t:t14}}</p></div></div><div><img width=\"1050\" height=\"1400\" src=\"{{i:i3}}\" alt=\"Study guide for Attention To Dollars, the 15-Stage Checklist, for your phone\" loading=\"lazy\" decoding=\"async\" data-sjc-img=\"i3\"><div><p class=\"font-[var(--font-family-body)]\" style=\"color:#fff;font-weight:700;margin:0;line-height:1.3\">{{t:t15}}</p><p class=\"font-[var(--font-family-body)]\" style=\"color:#fff;opacity:.85;margin:4px 0 0;font-size:14px;line-height:1.45\">{{t:t16}}</p></div></div><div><img width=\"1050\" height=\"1400\" src=\"{{i:i4}}\" alt=\"Study guide for Attention To Dollars, the 15-Stage Checklist, for your tablet\" loading=\"lazy\" decoding=\"async\" data-sjc-img=\"i4\"><div><p class=\"font-[var(--font-family-body)]\" style=\"color:#fff;font-weight:700;margin:0;line-height:1.3\">{{t:t17}}</p><p class=\"font-[var(--font-family-body)]\" style=\"color:#fff;opacity:.85;margin:4px 0 0;font-size:14px;line-height:1.45\">{{t:t18}}</p></div></div><div><img width=\"1050\" height=\"1400\" src=\"{{i:i5}}\" alt=\"Study guide for Attention To Dollars, the 15-Stage Checklist, for your laptop\" loading=\"lazy\" decoding=\"async\" data-sjc-img=\"i5\"><div><p class=\"font-[var(--font-family-body)]\" style=\"color:#fff;font-weight:700;margin:0;line-height:1.3\">{{t:t19}}</p><p class=\"font-[var(--font-family-body)]\" style=\"color:#fff;opacity:.85;margin:4px 0 0;font-size:14px;line-height:1.45\">{{t:t20}}</p></div></div></div></div></section>","text":[{"key":"t1","label":"Text: eyebrow","value":"What you get"},{"key":"t2","label":"Text: heading","value":"Five things, yours the minute you pay."},{"key":"t3","label":"Text: line","value":"The book in two formats and the study guide in three sizes, so each one fits the screen you open it on. Every copy is a signature edition with your name on it."},{"key":"t11","label":"Text: The book, for Apple Books","value":"The book, for Apple Books"},{"key":"t12","label":"Text: about the book, for apple books","value":"Opens in the Books app on an iPhone, an iPad or a Mac."},{"key":"t13","label":"Text: The book, for Kindle","value":"The book, for Kindle"},{"key":"t14","label":"Text: about the book, for kindle","value":"Opens in the Kindle app or on a Kindle."},{"key":"t15","label":"Text: Study guide, phone size","value":"Study guide, phone size"},{"key":"t16","label":"Text: about study guide, phone size","value":"All fifteen stages as a tick list, sized to fill a phone screen."},{"key":"t17","label":"Text: Study guide, tablet size","value":"Study guide, tablet size"},{"key":"t18","label":"Text: about study guide, tablet size","value":"The same tick list, sized to fill a tablet."},{"key":"t19","label":"Text: Study guide, laptop size","value":"Study guide, laptop size"},{"key":"t20","label":"Text: about study guide, laptop size","value":"The same tick list, sized to fill a laptop screen."}],"boxes":[],"links":[],"sheet":"7b6d59e91bbcfde5","images":[{"alt":"The book Attention To Dollars shown on a tablet","key":"i1","src":"https://ddhmhtqvn5lepkpr.public.blob.vercel-storage.com/sites/sjc-website/uploads/1791497834900-five-1-apple-books-glow-and-rims.webp"},{"alt":"The book Attention To Dollars shown on a Kindle","key":"i2","src":"https://ddhmhtqvn5lepkpr.public.blob.vercel-storage.com/sites/sjc-website/uploads/1791497628064-five-2-kindle-light-kindle.webp"},{"alt":"Study guide for Attention To Dollars, the 15-Stage Checklist, for your phone","key":"i3","src":"https://ddhmhtqvn5lepkpr.public.blob.vercel-storage.com/sites/sjc-website/uploads/1791499897879-study-guide-tile-phone.webp"},{"alt":"Study guide for Attention To Dollars, the 15-Stage Checklist, for your tablet","key":"i4","src":"https://ddhmhtqvn5lepkpr.public.blob.vercel-storage.com/sites/sjc-website/uploads/1791499897879-study-guide-tile-tablet.webp"},{"alt":"Study guide for Attention To Dollars, the 15-Stage Checklist, for your laptop","key":"i5","src":"https://ddhmhtqvn5lepkpr.public.blob.vercel-storage.com/sites/sjc-website/uploads/1791499897879-study-guide-tile-laptop.webp"}],"calLink":"","hasForm":false,"formButton":"","formFields":[],"paddingTop":48,"useRealForm":false,"paddingBottom":48}},{"type":"DesignSection","props":{"id":"book-checkout","band":"ink-glow","html":"<section class=\"code-section relative py-10 lg:py-14 overflow-hidden\" id=\"sbookpay\">\n<style>\n#sbookpay .buy-pay{margin:0 auto;max-width:620px;scroll-margin-top:120px}\n#sbookpay .buy-form{background:#A1967F;overflow:hidden;border:1.5px solid #DE8634;border-radius:1.25rem;padding:10px;min-height:420px;color:#14100C;box-shadow:0 0 28px rgba(224,138,46,.22),0 18px 44px rgba(0,0,0,.6)}\n#sbookpay [data-sjc-book-checkout]{display:block;width:100%;min-height:400px;text-align:center;font-family:var(--font-family-body);color:#14100C;padding:0}\n#sbookpay [data-sjc-book-checkout]>*,#sbookpay [data-sjc-book-checkout] iframe{display:block;width:100%!important;min-width:100%!important;max-width:100%}\n</style>\n<div class=\"container mx-auto px-4\"><div class=\"buy-pay\" id=\"checkout\">\n<p class=\"font-[var(--font-family-body)] font-bold\" style=\"margin:0 0 12px;color:#F6BC76;letter-spacing:.08em;text-transform:uppercase;text-align:center\">{{t:t1}}</p>\n<div class=\"buy-form\"><div data-sjc-book-checkout>Loading the secure checkout…</div></div>\n</div></div></section>","text":[{"key":"t1","label":"Text: label above the card form","value":"Checkout"}],"boxes":[],"links":[],"sheet":"7b6d59e91bbcfde5","images":[],"calLink":"","hasForm":false,"formButton":"","formFields":[],"paddingTop":48,"useRealForm":false,"paddingBottom":48}}]}}