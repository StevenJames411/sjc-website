{"data":{"root":{"props":{}},"zones":{},"content":[{"type":"DesignSection","props":{"id":"design-11","html":"<footer id=\"global-footer\" class=\"code-section bg-[var(--primary-color)] text-white\">\n  <style>\n    /* ⛔ THE LAYOUT IS PLAIN CSS ON PURPOSE. The compiled Tailwind sheet for this site has no\n       md:justify-between, md:items-center, md:text-left, md:gap-*, sm:h-*, gap-x-* or gap-y-* in\n       it -- a class that is not in the sheet is silently nothing, so a footer built out of them\n       would collapse with no error. Only classes already in the sheet are used below. */\n    .sjc-foot{}\n    .sjc-foot-top{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px 32px}\n    .sjc-foot-brand{display:flex;align-items:center;gap:12px;text-decoration:none}\n    .sjc-foot-bottom{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;\n      gap:8px 24px;margin-top:16px;padding-top:14px;border-top:1px solid rgba(255,255,255,.2)}\n    @media(max-width:820px){\n      .sjc-foot-top,.sjc-foot-bottom{justify-content:center;text-align:center}\n    }\n  \n  #global-header .sjc-mark,#global-footer .sjc-mark{\n    display:inline-flex;align-items:baseline;gap:.26em;line-height:1.05;white-space:nowrap;\n  }\n  #global-header .sjc-mark span,#global-footer .sjc-mark span{\n    font-family:var(--font-playfair),\"Playfair Display\",Georgia,serif;\n    font-variant:small-caps;font-weight:500;letter-spacing:.045em;line-height:1.05;\n  }\n  #global-header .sjc-mark .m1{color:#fff}\n  #global-header .sjc-mark .m2{color:var(--accent2-color,#ffd700)}\n  #global-footer .sjc-mark .m1{color:#fff}\n  #global-footer .sjc-mark .m2{color:var(--accent2-color,#ffd700)}\n  #global-header .sjc-mark span{font-size:clamp(23px,2.6vw,32px)}\n  #global-footer .sjc-mark span{font-size:23px}\n  #global-header a:hover .sjc-mark .m1,#global-footer a:hover .sjc-mark .m1{color:var(--accent2-color,#ffd700)}\n</style>\n  <div class=\"container mx-auto px-4 sjc-foot\">\n\n    <div class=\"sjc-foot-top\">\n      <a href=\"{{h:h1}}\" class=\"sjc-foot-brand\" data-sjc-link=\"h1\">\n        <img src=\"{{i:i1}}\" alt=\"Steven James Consulting Logo\" class=\"h-12\" data-logo data-sjc-img=\"i1\">\n        <span class=\"sjc-mark\"><span class=\"m1\">{{t:t1}}</span><span class=\"m2\">{{t:t16}}</span></span>\n      </a>\n    </div>\n\n    <div class=\"sjc-foot-disclaimer\"><p>{{t:t8}}</p></div><div class=\"sjc-foot-bottom\">\n      <p class=\"text-sm text-white font-[var(--font-family-body)]\">\n        {{t:t11}} <span id=\"copyright-year\">{{t:t12}}</span> {{t:t13}}\n      </p>\n      <div class=\"sjc-foot-legal flex space-x-6\">\n        <a href=\"{{h:h8}}\" target=\"_blank\" class=\"text-sm text-white hover:text-[var(--accent3-color)] font-[var(--font-family-body)] transition-colors duration-300\" data-sjc-link=\"h8\">{{t:t14}}</a>\n        <a href=\"{{h:h9}}\" target=\"_blank\" class=\"text-sm text-white hover:text-[var(--accent3-color)] font-[var(--font-family-body)] transition-colors duration-300\" data-sjc-link=\"h9\">{{t:t15}}</a>\n      </div>\n    </div>\n  </div>\n</footer>\n","text":[{"key":"t1","label":"Wordmark: Steven James","value":"Steven James"},{"key":"t16","label":"Wordmark: Consulting","value":"Consulting"},{"key":"t11","label":"©","value":"©"},{"key":"t12","label":"2026","value":"2026"},{"key":"t13","label":"- Parent Company ARV Venture Group, DBA Stev…","value":"- Parent Company ARV Venture Group, DBA Steven James Consulting - All rights reserved."},{"key":"t14","label":"Privacy Policy","value":"Privacy Policy"},{"key":"t15","label":"Terms of Service","value":"Terms of Service"},{"key":"t8","label":"Text: Legal disclaimer","value":"Results shown on this site are examples of what specific clients achieved and are not a promise or guarantee of any particular outcome. Your results depend on your market, your offer, your budget and your own effort. Book descriptions, quotations and product summaries on this site are the words of their authors, publishers or makers and are reproduced for reference; they are not our claims, we do not verify them, and nothing on this site is financial, investment, tax, legal or medical advice. Some outbound links may earn us a commission at no additional cost to you."}],"boxes":[],"links":[{"key":"h1","href":"/","label":"Home"},{"key":"h8","href":"https://www.privacypolicies.com/live/1cbbc5dd-5b42-4b68-abdd-a279a5e3b4f7","label":"Privacy Policy"},{"key":"h9","href":"https://www.privacypolicies.com/live/34bb5cc7-32b9-4449-ae32-7cfe78f34e45","label":"Terms of Service"}],"sheet":"7b6d59e91bbcfde5","images":[{"alt":"Steven James Consulting Logo","key":"i1","src":"https://ddhmhtqvn5lepkpr.public.blob.vercel-storage.com/sites/sjc-landingsite-build/home/1787778083280-1.webp"}],"calLink":"","hasForm":false,"formButton":"","formFields":[],"paddingTop":10,"useRealForm":false,"paddingBottom":18}}]}}