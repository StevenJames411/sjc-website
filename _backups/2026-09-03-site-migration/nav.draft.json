{"data":{"root":{"props":{}},"zones":{},"content":[{"type":"DesignSection","props":{"id":"design-1","html":"<style>\n  /* ⛔ gap-8 IS NOT IN THIS SITE'S COMPILED TAILWIND SHEET -- swapping space-x-8 for it collapsed\n     the nav to zero spacing, silently. space-x-8 stays; this only cancels the stray margin-right\n     that was sitting on the first item and making the gap after it 64px against 32px elsewhere.\n     ⚠️ Broadened from `> a:first-child` to `> *:first-child` on 2026-08-30: the first child of the\n     desktop nav is now the Services dropdown DIV, so the `a` selector stopped matching. */\n  #global-header nav > *:first-child { margin-right: 0; }\n  /* Same stray margin in the drawer: space-y-3 puts 12px between items, but the FIRST link\n     also carried its own margin-bottom, so the gap under the first item read as a section break\n     the others did not have. Zero it, and put the breathing room where it belongs -- between the\n     blue bar and the list. Plain CSS, so no sealed-sheet class to miss. */\n  #global-header [data-landingsite-mobile-menu] > div > *:first-child { margin-bottom: 0; }\n  #global-header [data-landingsite-mobile-menu] > div { padding-top: 28px; padding-bottom: 8px; }\n\n  /* ── DROPDOWNS (added 2026-08-30 with the deep pages) ──────────────────────────────────────\n     ⛔ PLAIN CSS ON PURPOSE. The imported sheet 7b6d59e91bbcfde5 is compiled and frozen at 1,436\n     class names with no `md:`/`gap-*` utilities in it -- a class that is not already in the sheet\n     renders as NOTHING, with no error. Anything new here has to be hand-written CSS.\n     ⚠️ CSS-only (hover + focus-within), no JS. The panels live inside `hidden lg:flex`, so they\n     only exist at >=1024px where a pointer does; touch users get the drawer below, which lists\n     every link flat. focus-within is what keeps it keyboard-reachable. */\n  #global-header .sjc-menu { position: relative; display: inline-flex; align-items: center; }\n  #global-header .sjc-trigger {\n    display: inline-flex; align-items: center; gap: 7px; background: none; border: 0; padding: 0;\n    margin: 0; cursor: pointer; color: #fff; font: inherit; line-height: inherit;\n    transition: color .3s;\n  }\n  #global-header .sjc-menu:hover .sjc-trigger,\n  #global-header .sjc-menu:focus-within .sjc-trigger { color: var(--accent2-color); }\n  #global-header .sjc-trigger svg {\n    width: .55em; height: .55em; display: inline-block; transition: transform .25s;\n  }\n  #global-header .sjc-menu:hover .sjc-trigger svg,\n  #global-header .sjc-menu:focus-within .sjc-trigger svg { transform: rotate(180deg); }\n  /* ⚠️ THE HOVER BRIDGE. Without it the 14px gap between the trigger and the panel is dead space,\n     the pointer crosses it, :hover drops and the menu shuts before you reach an item. */\n  #global-header .sjc-menu::after {\n    content: \"\"; position: absolute; top: 100%; left: 0; right: 0; height: 16px;\n  }\n  /* ⛔ THE PANEL'S LOOK IS NOT SET HERE ANY MORE (2026-09-01). Background, border, shadow and\n     the link capsules moved to app/globals.css so the desktop panel and the phone drawer are\n     skinned from ONE place. Those rules are !important and will beat anything you add below.\n     What still lives here: where the panel sits, the hover bridge, and the open/close. */\n  #global-header .sjc-drop {\n    position: absolute; top: 100%; left: 50%; transform: translate(-50%, 8px);\n    min-width: 252px; padding: 9px 0; z-index: 80;\n    background: var(--primary-color); border: 1px solid rgba(255,255,255,.13); border-radius: 12px;\n    box-shadow: 0 20px 44px rgba(0,0,0,.34);\n    opacity: 0; visibility: hidden; transition: opacity .2s ease, transform .2s ease;\n  }\n  #global-header .sjc-menu:hover .sjc-drop,\n  #global-header .sjc-menu:focus-within .sjc-drop {\n    opacity: 1; visibility: visible; transform: translate(-50%, 0);\n  }\n  #global-header .sjc-drop a {\n    display: block; padding: 11px 22px; color: #fff; white-space: nowrap; text-decoration: none;\n    transition: background .2s, color .2s;\n  }\n  #global-header .sjc-drop a:hover, #global-header .sjc-drop a:focus {\n    background: rgba(255,255,255,.10); color: var(--accent2-color);\n  }\n  /* ── the same links, flat, in the mobile drawer ─────────────────────────────────────────── */\n  #global-header .sjc-mgroup {\n    color: rgba(255,255,255,.55); font-size: 11px; letter-spacing: .18em; text-transform: uppercase;\n    padding: 16px 0 2px;\n  }\n  #global-header [data-landingsite-mobile-menu] a.sjc-sub { padding-left: 15px; }\n\n  #global-header .sjc-mark,#global-footer .sjc-mark{\n    display:inline-flex;align-items:baseline;gap:.26em;line-height:1.05;white-space:nowrap;\n  }\n  #global-header .sjc-mark span,#global-footer .sjc-mark span{\n    font-family:var(--font-playfair),\"Playfair Display\",Georgia,serif;\n    font-variant:small-caps;font-weight:500;letter-spacing:.045em;line-height:1.05;\n  }\n  #global-header .sjc-mark .m1{color:#fff}\n  #global-header .sjc-mark .m2{color:var(--accent2-color,#ffd700)}\n  #global-footer .sjc-mark .m1{color:#fff}\n  #global-footer .sjc-mark .m2{color:var(--accent2-color,#ffd700)}\n  #global-header .sjc-mark span{font-size:clamp(23px,2.6vw,32px)}\n  #global-footer .sjc-mark span{font-size:23px}\n  #global-header a:hover .sjc-mark .m1,#global-footer a:hover .sjc-mark .m1{color:var(--accent2-color,#ffd700)}\n\n  /* ── THE FIVE SYSTEMS, THEN THE LAYER ─────────────────────────────────────────────────────\n     ⛔ THE PILL IS THE DIVIDER. A rule between the five and the sixth item failed twice - white\n     vanished over a white band, grey vanished over everything, and a 1px line is not visible to\n     a human either way. Steven, 2026-09-02: \"the pill is the divider because it's different than\n     the rest.\" So the caption moved INSIDE the AI pill as a second line, the pill is taller than\n     the other five, and its border is money green instead of gold. Nothing to see through, and\n     it reads on any background the menu happens to open over. */\n  #global-header .sjc-drop-layer{border-color:#85bb65 !important;padding-top:11px !important;\n    padding-bottom:11px !important;line-height:1.25}\n  #global-header .sjc-drop-layer:hover,#global-header .sjc-drop-layer:focus{\n    background:#85bb65 !important;border-color:#85bb65 !important;color:#08120a !important}\n  #global-header .sjc-layer-sub{display:block;margin-top:5px;font-size:9.5px;font-weight:700;\n    letter-spacing:.13em;text-transform:uppercase;color:#85bb65}\n  #global-header .sjc-drop-layer:hover .sjc-layer-sub,\n  #global-header .sjc-drop-layer:focus .sjc-layer-sub{color:#0b2413}\n</style><header id=\"global-header\" class=\"code-section bg-[var(--primary-color)] shadow-md w-full\">\n  <div class=\"container mx-auto px-4\">\n    <div class=\"flex items-center justify-between\">\n\n      <a href=\"{{h:h1}}\" class=\"flex-shrink-0 flex items-center gap-3\" data-sjc-link=\"h1\">\n        <img src=\"{{i:i1}}\" alt=\"Steven James Consulting\" class=\"h-12 lg:h-14\" data-logo data-sjc-img=\"i1\">\n        <span class=\"sjc-mark\"><span class=\"m1\">{{t:t1}}</span><span class=\"m2\">{{t:t18}}</span></span>\n      </a>\n\n      <nav class=\"hidden lg:flex items-center space-x-8\"><div class=\"sjc-menu\"><button type=\"button\" class=\"sjc-trigger\" aria-haspopup=\"true\">{{t:t2}}<svg viewBox=\"0 0 320 512\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M137.4 374.6c12.5 12.5 32.8 12.5 45.3 0l128-128c9.2-9.2 11.9-22.9 6.9-34.9s-16.6-19.8-29.6-19.8L32 192c-12.9 0-24.6 7.8-29.6 19.8s-2.2 25.7 6.9 34.9l128 128z\"/></svg></button><div class=\"sjc-drop\"><a href=\"{{h:h2}}\" data-sjc-link=\"h2\">{{t:t3}}</a><a href=\"{{h:h4}}\" data-sjc-link=\"h4\">{{t:t5}}</a><a href=\"{{h:h3}}\" data-sjc-link=\"h3\">{{t:t4}}</a><a href=\"{{h:h7}}\" data-sjc-link=\"h7\">{{t:t8}}</a><a href=\"{{h:h5}}\" data-sjc-link=\"h5\">{{t:t6}}</a><a href=\"{{h:h6}}\" class=\"sjc-drop-layer\" data-sjc-link=\"h6\">{{t:t7}}<span class=\"sjc-layer-sub\">{{t:t20}}</span></a><a href=\"{{h:h12}}\" data-sjc-link=\"h12\">{{t:t14}}</a><a href=\"{{h:h16}}\" data-sjc-link=\"h16\">{{t:t19}}</a><a href=\"{{h:h14}}\" data-sjc-link=\"h14\">{{t:t16}}</a></div></div><div class=\"sjc-menu\"><button type=\"button\" class=\"sjc-trigger\" aria-haspopup=\"true\">{{t:t9}}<svg viewBox=\"0 0 320 512\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M137.4 374.6c12.5 12.5 32.8 12.5 45.3 0l128-128c9.2-9.2 11.9-22.9 6.9-34.9s-16.6-19.8-29.6-19.8L32 192c-12.9 0-24.6 7.8-29.6 19.8s-2.2 25.7 6.9 34.9l128 128z\"/></svg></button><div class=\"sjc-drop\"><a href=\"{{h:h8}}\" data-sjc-link=\"h8\">{{t:t10}}</a><a href=\"{{h:h10}}\" data-sjc-link=\"h10\">{{t:t12}}</a><a href=\"{{h:h11}}\" data-sjc-link=\"h11\">{{t:t13}}</a><a href=\"{{h:h15}}\" target=\"_blank\" rel=\"noopener\" data-sjc-link=\"h15\">{{t:t17}}</a></div></div></nav>\n\n      <button data-landingsite-mobile-menu-toggle=\"\" class=\"lg:hidden text-white focus:outline-none\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\" class=\"text-3xl\" style=\"width:1em;height:1em;display:inline-block;vertical-align:-0.125em;fill:currentColor\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M0 96C0 78.3 14.3 64 32 64l384 0c17.7 0 32 14.3 32 32s-14.3 32-32 32L32 128C14.3 128 0 113.7 0 96zM0 256c0-17.7 14.3-32 32-32l384 0c17.7 0 32 14.3 32 32s-14.3 32-32 32L32 288c-17.7 0-32-14.3-32-32zM448 416c0 17.7-14.3 32-32 32L32 448c-17.7 0-32-14.3-32-32s14.3-32 32-32l384 0c17.7 0 32 14.3 32 32z\"></path></svg>\n      </button>\n    </div>\n\n    <nav data-landingsite-mobile-menu=\"\" class=\"hidden lg:hidden pb-4\"><div class=\"flex flex-col space-y-3 pt-4\"><div class=\"sjc-mgroup\">{{t:t2}}</div><a href=\"{{h:h2}}\" class=\"text-white hover:text-[var(--accent2-color)] font-[var(--font-family-body)] transition-colors duration-300 py-2 sjc-sub\" data-sjc-link=\"h2\">{{t:t3}}</a><a href=\"{{h:h4}}\" class=\"text-white hover:text-[var(--accent2-color)] font-[var(--font-family-body)] transition-colors duration-300 py-2 sjc-sub\" data-sjc-link=\"h4\">{{t:t5}}</a><a href=\"{{h:h3}}\" class=\"text-white hover:text-[var(--accent2-color)] font-[var(--font-family-body)] transition-colors duration-300 py-2 sjc-sub\" data-sjc-link=\"h3\">{{t:t4}}</a><a href=\"{{h:h7}}\" class=\"text-white hover:text-[var(--accent2-color)] font-[var(--font-family-body)] transition-colors duration-300 py-2 sjc-sub\" data-sjc-link=\"h7\">{{t:t8}}</a><a href=\"{{h:h5}}\" class=\"text-white hover:text-[var(--accent2-color)] font-[var(--font-family-body)] transition-colors duration-300 py-2 sjc-sub\" data-sjc-link=\"h5\">{{t:t6}}</a><a href=\"{{h:h6}}\" class=\"text-white hover:text-[var(--accent2-color)] font-[var(--font-family-body)] transition-colors duration-300 py-2 sjc-sub sjc-drop-layer\" data-sjc-link=\"h6\">{{t:t7}}<span class=\"sjc-layer-sub\">{{t:t20}}</span></a><a href=\"{{h:h12}}\" class=\"text-white hover:text-[var(--accent2-color)] font-[var(--font-family-body)] transition-colors duration-300 py-2 sjc-sub\" data-sjc-link=\"h12\">{{t:t14}}</a><a href=\"{{h:h16}}\" class=\"text-white hover:text-[var(--accent2-color)] font-[var(--font-family-body)] transition-colors duration-300 py-2 sjc-sub\" data-sjc-link=\"h16\">{{t:t19}}</a><a href=\"{{h:h14}}\" class=\"text-white hover:text-[var(--accent2-color)] font-[var(--font-family-body)] transition-colors duration-300 py-2 sjc-sub\" data-sjc-link=\"h14\">{{t:t16}}</a><div class=\"sjc-mgroup\">{{t:t9}}</div><a href=\"{{h:h8}}\" class=\"text-white hover:text-[var(--accent2-color)] font-[var(--font-family-body)] transition-colors duration-300 py-2 sjc-sub\" data-sjc-link=\"h8\">{{t:t10}}</a><a href=\"{{h:h10}}\" class=\"text-white hover:text-[var(--accent2-color)] font-[var(--font-family-body)] transition-colors duration-300 py-2 sjc-sub\" data-sjc-link=\"h10\">{{t:t12}}</a><a href=\"{{h:h11}}\" class=\"text-white hover:text-[var(--accent2-color)] font-[var(--font-family-body)] transition-colors duration-300 py-2 sjc-sub\" data-sjc-link=\"h11\">{{t:t13}}</a><a href=\"{{h:h15}}\" target=\"_blank\" rel=\"noopener\" class=\"text-white hover:text-[var(--accent2-color)] font-[var(--font-family-body)] transition-colors duration-300 py-2 sjc-sub\" data-sjc-link=\"h15\">{{t:t17}}</a></div></nav>\n  </div>\n</header>\n","text":[{"key":"t1","label":"Wordmark: Steven James","value":"Steven James"},{"key":"t18","label":"Wordmark: Consulting","value":"Consulting"},{"key":"t2","label":"Menu: Services","value":"Systems"},{"key":"t3","label":"Link: Premium Smart Websites","value":"Premium Smart Websites"},{"key":"t4","label":"Link: Automated Five Star Reviews","value":"Automated Five Star Reviews"},{"key":"t5","label":"Link: Speed to Lead","value":"Speed to Lead"},{"key":"t6","label":"Link: Paid Ads = Booked Appointments","value":"Paid Ads = Booked Appointments"},{"key":"t7","label":"Link: Your AI Employee","value":"AI Implementation"},{"key":"t8","label":"Link: Database Reactivation","value":"Database Reactivation"},{"key":"t9","label":"Menu: Company","value":"Company"},{"key":"t10","label":"Link: About","value":"About"},{"key":"t12","label":"Link: Podcast","value":"Podcast"},{"key":"t13","label":"Link: Careers","value":"Careers"},{"key":"t14","label":"Link: Companies We Serve","value":"Companies We Serve"},{"key":"t16","label":"Link: FAQs","value":"FAQs"},{"key":"t17","label":"Link: Community","value":"Skool Community"},{"key":"t19","label":"Link: Portfolio","value":"Portfolio"},{"key":"t20","label":"Menu: AI sub-line","value":"the layer that connects them"}],"boxes":[],"links":[{"key":"h1","href":"/","label":"Home"},{"key":"h2","href":"/premium-smart-websites","label":"Premium Smart Websites"},{"key":"h4","href":"/speed-to-lead","label":"Speed to Lead"},{"key":"h3","href":"/automated-five-star-reviews","label":"Automated Five Star Reviews"},{"key":"h7","href":"/database-reactivation","label":"Database Reactivation"},{"key":"h5","href":"/booked-appointments","label":"Paid Ads = Booked Appointments"},{"key":"h6","href":"/ai-implementation","label":"AI Implementation"},{"key":"h8","href":"/about","label":"About"},{"key":"h10","href":"/podcast","label":"Podcast"},{"key":"h11","href":"/careers","label":"Careers"},{"key":"h15","href":"https://www.skool.com/group-home-network-9951/about","label":"Skool Community"},{"key":"h16","href":"/premium-smart-websites#srj8qqe","label":"Portfolio"}],"sheet":"7b6d59e91bbcfde5","images":[{"alt":"Steven James Consulting","key":"i1","src":"https://ddhmhtqvn5lepkpr.public.blob.vercel-storage.com/sites/sjc-landingsite-build/home/1787778083280-1.webp"}],"sticky":true,"calLink":"","hasForm":false,"formButton":"","formFields":[],"paddingTop":10,"useRealForm":false,"paddingBottom":10}}]}}